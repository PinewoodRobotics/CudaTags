include CMakeLists.txt
include LICENSE.txt
include README.md
include pyproject.toml
include setup.py

# Source code needed for Python build
graft detection
graft src/main/cpp
graft src/main/python

# Exclude build artifacts
prune detection/build
prune detection/third_party/allwpilib
prune build
prune target
prune install
prune src/main/python/cuda_tags.egg-info

# Exclude other languages and tests (not needed for the Python build)
prune src/main/java
prune src/main/rust
prune tests

# Exclude other unnecessary files
exclude Dockerfile
exclude compose.yml
exclude .devcontainer/*
exclude .vscode/*

# Exclude compiled Python files and shared libraries (build artifacts)
global-exclude *.py[cod] __pycache__ *.so *.dylib *.a
