CompileFlags:
  # Configure first: cmake -S . -B build (writes build/compile_commands.json)
  CompilationDatabase: build
  Add:
    - -std=c++20
    - -I../src/main/cpp/include
    - -I../detection
    - -I../detection/third_party
    - -I/usr/local/cuda/include
    - -I/usr/include/opencv4
Index:
  Background: Build
